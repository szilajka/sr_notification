# Copy this file to .env and set a password of your own. .env is git-ignored.
# Read by docker compose, by the RSS reader and by the `dotnet ef` tools.
POSTGRES_PASSWORD=change-me

# --- Sign-in with Microsoft Entra External ID (see README, "Part 2") ---
# https://<tenant-subdomain>.ciamlogin.com/<tenant-id>/v2.0
OIDC_AUTHORITY=
# Application (client) ID of the app registration
OIDC_CLIENT_ID=
# Client secret of the app registration
OIDC_CLIENT_SECRET=
# Optional: this sign-in email becomes an admin without the Entra app role (to bootstrap the first admin)
ADMIN_EMAIL=
# Public address of the web app, used in links sent by email. Required in production.
# Leave empty for local development (docker compose then uses http://localhost:8080).
PUBLIC_URL=
